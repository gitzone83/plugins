<form>
    <field>
        <id>credential.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this SNMP credential profile.</help>
    </field>
    <field>
        <id>credential.name</id>
        <label>Name</label>
        <type>text</type>
        <help>A unique name for this credential profile.</help>
    </field>
    <field>
        <id>credential.version</id>
        <label>SNMP Version</label>
        <type>dropdown</type>
        <help>Select SNMPv2c or SNMPv3.</help>
    </field>
    <field>
        <id>credential.community</id>
        <label>Community String</label>
        <type>text</type>
        <help>SNMPv2c community string (e.g. "public").</help>
    </field>
    <field>
        <id>credential.v3Username</id>
        <label>SNMPv3 Username</label>
        <type>text</type>
        <help>SNMPv3 security name / username.</help>
    </field>
    <field>
        <id>credential.v3SecurityLevel</id>
        <label>Security Level</label>
        <type>dropdown</type>
        <help>SNMPv3 security level.</help>
    </field>
    <field>
        <id>credential.v3AuthProto</id>
        <label>Auth Protocol</label>
        <type>dropdown</type>
        <help>SNMPv3 authentication protocol.</help>
    </field>
    <field>
        <id>credential.v3AuthKey</id>
        <label>Auth Passphrase</label>
        <type>password</type>
        <help>SNMPv3 authentication passphrase (min 8 characters).</help>
    </field>
    <field>
        <id>credential.v3PrivProto</id>
        <label>Privacy Protocol</label>
        <type>dropdown</type>
        <help>SNMPv3 privacy / encryption protocol.</help>
    </field>
    <field>
        <id>credential.v3PrivKey</id>
        <label>Privacy Passphrase</label>
        <type>password</type>
        <help>SNMPv3 privacy passphrase (min 8 characters).</help>
    </field>
    <field>
        <id>credential.description</id>
        <label>Description</label>
        <type>text</type>
        <help>Optional description for this credential profile.</help>
    </field>
</form>
